{
  "name": "juice10",
  "productName": "Juice10",
  "version": "1.0.0",
  "description": "사진 보정용 픽셀 유동화(Liquify) 데스크톱 앱",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Juice10 --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=com.jihwan.juice10 --app-category-type=public.app-category.photography --icon=build/icon.icns --extend-info=build/Info.plist --ignore='^/dist' --ignore='^/build' --ignore='^/\\.claude' --ignore='^/test'",
    "postpackage": "/usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName 과즙 10%' dist/Juice10-darwin-arm64/Juice10.app/Contents/Info.plist && codesign --force --deep --sign - dist/Juice10-darwin-arm64/Juice10.app",
    "install-app": "npm run package && rm -rf /Applications/Juice10.app && cp -R dist/Juice10-darwin-arm64/Juice10.app /Applications/Juice10.app"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "@electron/packager": "^18.3.6"
  }
}
